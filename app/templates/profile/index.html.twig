{% extends 'base.html.twig' %}

{% block title %}{{ page_title }}{% endblock %}

{% block content %}
<div class="profile-page">
    <div class="profile-container">
        <div class="profile-avatar-section">
            <div class="profile-avatar-wrapper">
                <img src="{{ asset('images/avatars/' ~ avatar) }}" alt="Аватар" class="profile-avatar" id="profileAvatar">
            </div>
            <div class="profile-name">
                <span class="at-symbol">@</span>{{ app.user.username }}
            </div>
        </div>

        <div class="profile-email-section">
            <span class="profile-email-label">
                <img src="{{ asset('images/google-icon.svg') }}" alt="Google" style="width: 2vh; height: 2vh; object-fit: contain; display: inline-block; vertical-align: middle; margin-right: 0.5vh;">
                Gmail:
            </span>
            <div class="profile-email-value">
                {% if app.user.email %}
                    {{ app.user.email }}
                    {% if app.user.emailVerified %}
                        <span class="email-verified"></span>
                    {% else %}
                        <span class="email-not-verified">не подтверждён</span>
                    {% endif %}
                {% else %}
                    <span class="email-missing">не привязан</span>
                    <button onclick="bindEmail()" class="btn-bind-email">Привязать</button>
                {% endif %}
            </div>
        </div>

        <div class="profile-score-section">
            <div class="profile-score-item">
                <img src="{{ asset('images/fire-icon.png') }}" alt="Серия" style="width: 2.5vh; height: 2.5vh; object-fit: contain; display: inline-block; vertical-align: middle;">
                <span class="profile-score-label">Серия:</span>
                <span class="profile-score-value" id="profileStreak">{{ app.user.streak ?? 0 }}</span>
            </div>
            <div class="profile-score-item">
                <img src="{{ asset('images/target-icon.png') }}" alt="Очки" style="width: 2.5vh; height: 2.5vh; object-fit: contain; display: inline-block; vertical-align: middle;">
                <span class="profile-score-label">Очки:</span>
                <span class="profile-score-value" id="profileScore">{{ app.user.score ?? 0 }}</span>
            </div>
        </div>

        <div class="profile-stats-section">
            <div class="profile-stats-tabs">
                <button class="stats-tab active" data-mode="light" onclick="switchStatsMode('light')">
                    <img src="{{ asset('images/easy-icon.png') }}" alt="Лёгкая" style="width: 2vh; height: 2vh; object-fit: contain; display: inline-block; vertical-align: middle; margin-right: 0.5vh;">
                    Лёгкая
                </button>
                <button class="stats-tab" data-mode="hard" onclick="switchStatsMode('hard')">
                    <img src="{{ asset('images/hard-icon.png') }}" alt="Сложная" style="width: 2vh; height: 2vh; object-fit: contain; display: inline-block; vertical-align: middle; margin-right: 0.5vh;">
                    Сложная
                </button>
            </div>
            <div class="profile-stats-grid">
                <div class="profile-stat-card">
                    <div class="stat-title">
                        <img src="{{ asset('images/voice-icon.png') }}" alt="Вокал" style="width: 2.5vh; height: 2.5vh; object-fit: contain; display: inline-block; vertical-align: middle; margin-right: 0.5vh;">
                        Вокал
                    </div>
                    <div class="stat-circle" id="voiceStat">
                        <svg viewBox="0 0 120 120">
                            <defs>
                                <linearGradient id="profileGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                                    <stop offset="0%" style="stop-color:#4a9eff;stop-opacity:1" />
                                    <stop offset="100%" style="stop-color:#6c5ce7;stop-opacity:1" />
                                </linearGradient>
                            </defs>
                            <circle class="stat-circle-bg" cx="60" cy="60" r="50"/>
                            <circle class="stat-circle-fill" cx="60" cy="60" r="50" id="voiceCircle"/>
                        </svg>
                        <div class="stat-value" id="voiceValue">0%</div>
                    </div>
                </div>
                <div class="profile-stat-card">
                    <div class="stat-title">
                        <img src="{{ asset('images/ear-icon.png') }}" alt="Слух" style="width: 2.5vh; height: 2.5vh; object-fit: contain; display: inline-block; vertical-align: middle; margin-right: 0.5vh;">
                        Слух
                    </div>
                    <div class="stat-circle" id="hearingStat">
                        <svg viewBox="0 0 120 120">
                            <circle class="stat-circle-bg" cx="60" cy="60" r="50"/>
                            <circle class="stat-circle-fill" cx="60" cy="60" r="50" id="hearingCircle"/>
                        </svg>
                        <div class="stat-value" id="hearingValue">0%</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="profile-actions-wrapper">
            <button class="btn-edit-profile" onclick="openEditProfile()">
                <img src="{{ asset('images/edit-icon.png') }}" alt="Изменить" style="width: 2.5vh; height: 2.5vh; object-fit: contain; display: inline-block; vertical-align: middle; margin-right: 0.8vh;">
                Изменить профиль
            </button>
            <div class="profile-actions-row">
                <button onclick="confirmLogout()" class="btn-profile-action btn-logout">
                    <img src="{{ asset('images/logout-icon.png') }}" alt="Выйти" style="width: 2.5vh; height: 2.5vh; object-fit: contain; display: inline-block; vertical-align: middle; margin-right: 0.8vh;">
                    Выйти
                </button>
                <button onclick="confirmDelete()" class="btn-profile-action btn-delete">
                    <img src="{{ asset('images/delete-icon.png') }}" alt="Удалить" style="width: 2.5vh; height: 2.5vh; object-fit: contain; display: inline-block; vertical-align: middle; margin-right: 0.8vh;">
                    Удалить аккаунт
                </button>
            </div>
        </div>
    </div>
</div>

<div id="editProfileModal" class="modal" style="display: none;">
    <div class="modal-overlay" onclick="closeEditProfile()"></div>
    <div class="modal-content" style="max-width: 700px; max-height: 85vh; overflow-y: auto;">
        <button class="modal-close" onclick="closeEditProfile()">✕</button>
        <h2 class="modal-title">Редактировать профиль</h2>

        <div class="edit-avatar-wrapper">
            <img src="{{ asset('images/avatars/' ~ avatar) }}" alt="Аватар" class="edit-avatar" id="editAvatar">
            <button class="edit-avatar-btn" onclick="openAvatarEditor()">✏️</button>
        </div>

        <div class="edit-field">
            <label>Логин</label>
            <div class="edit-field-row">
                <span class="edit-field-prefix">@</span>
                <span class="edit-field-value" id="displayUsername">{{ app.user.username }}</span>
                <button onclick="openUsernameEditor()" class="edit-field-btn">Изменить</button>
            </div>
        </div>

        <div class="edit-field">
            <label>Пароль</label>
            <div class="edit-field-row">
                <span class="edit-field-value">••••••••</span>
                <button onclick="openPasswordEditor()" class="edit-field-btn">Изменить</button>
            </div>
        </div>

        <div class="edit-field">
            <label>Email</label>
            <div class="edit-field-row">
                <span class="edit-field-value" id="displayEmail">{{ app.user.email ? app.user.email : 'не привязан' }}</span>
                <button onclick="bindEmail()" class="edit-field-btn">Привязать</button>
            </div>
        </div>
    </div>
</div>

<div id="avatarEditorModal" class="modal" style="display: none;">
    <div class="modal-overlay" onclick="closeAvatarEditor()"></div>
    <div class="modal-content" style="max-width: 600px;">
        <button class="modal-close" onclick="closeAvatarEditor()">✕</button>
        <h2 class="modal-title">Выбор аватара</h2>

        <div class="avatar-selector-grid" id="avatarSelector">
        </div>

        <button onclick="unlockRandomAvatar()" class="btn-unlock-avatar">
            <img src="{{ asset('images/unlock-icon.png') }}" alt="Открыть" style="width: 2vh; height: 2vh; object-fit: contain; display: inline-block; vertical-align: middle; margin-right: 0.8vh;">
            Открыть новый аватар за 1000 очков
        </button>
        <div id="avatarUnlockStatus" class="input-status"></div>

        <button onclick="saveAvatar()" class="modal-btn-primary" style="margin-top: 12px;">
            <img src="{{ asset('images/save-icon.png') }}" alt="Сохранить" style="width: 2.5vh; height: 2.5vh; object-fit: contain; display: inline-block; vertical-align: middle; margin-right: 0.8vh;">
            Сохранить аватар
        </button>
    </div>
</div>

<div id="usernameEditorModal" class="modal" style="display: none;">
    <div class="modal-overlay" onclick="closeUsernameEditor()"></div>
    <div class="modal-content" style="max-width: 420px;">
        <button class="modal-close" onclick="closeUsernameEditor()">✕</button>
        <h2 class="modal-title">Сменить логин</h2>

        <div class="modal-input-group">
            <label>Новый логин</label>
            <input type="text" id="editUsername" value="{{ app.user.username }}" placeholder="Новый логин">
            <div id="editUsernameStatus" class="input-status"></div>
        </div>

        <button onclick="saveUsername()" class="modal-btn-primary">
            <img src="{{ asset('images/save-icon.png') }}" alt="Сохранить" style="width: 2.5vh; height: 2.5vh; object-fit: contain; display: inline-block; vertical-align: middle; margin-right: 0.8vh;">
            Сохранить
        </button>
    </div>
</div>

<div id="passwordEditorModal" class="modal" style="display: none;">
    <div class="modal-overlay" onclick="closePasswordEditor()"></div>
    <div class="modal-content" style="max-width: 420px;">
        <button class="modal-close" onclick="closePasswordEditor()">✕</button>
        <h2 class="modal-title"> Сменить пароль</h2>

        <div class="modal-input-group">
            <label>Старый пароль</label>
            <input type="password" id="editOldPassword" placeholder="Введите старый пароль">
        </div>
        <div class="modal-input-group">
            <label>Новый пароль</label>
            <input type="password" id="editNewPassword" placeholder="Новый пароль (мин. 6 символов)">
        </div>
        <div class="modal-input-group">
            <label>Повторите пароль</label>
            <input type="password" id="editConfirmPassword" placeholder="Повторите новый пароль">
            <div id="editPasswordStatus" class="input-status"></div>
        </div>

        <button onclick="savePassword()" class="modal-btn-primary">
            <img src="{{ asset('images/save-icon.png') }}" alt="Сохранить" style="width: 2.5vh; height: 2.5vh; object-fit: contain; display: inline-block; vertical-align: middle; margin-right: 0.8vh;">
            Сохранить
        </button>
    </div>
</div>

<div id="confirmDeleteModal" class="modal" style="display: none;">
    <div class="modal-overlay" onclick="closeConfirmDelete()"></div>
    <div class="modal-content" style="max-width: 420px; text-align: center;">
        <button class="modal-close" onclick="closeConfirmDelete()">✕</button>
        <h2 style="color: var(--text-primary); font-size: 24px; margin-bottom: 16px;"> Удалить аккаунт?</h2>
        <p style="color: var(--text-secondary); margin-bottom: 24px;">Все данные будут безвозвратно удалены. Вы уверены?</p>
        <div style="display: flex; gap: 12px; justify-content: center;">
            <button onclick="closeConfirmDelete()" class="modal-btn-primary" style="background: var(--bg-primary); color: var(--text-primary); flex: 1;">Отмена</button>
            <button onclick="deleteAccount()" class="modal-btn-primary" style="background: #ff1744; flex: 1;">Удалить</button>
        </div>
    </div>
</div>

<div id="confirmLogoutModal" class="modal" style="display: none;">
    <div class="modal-overlay" onclick="closeConfirmLogout()"></div>
    <div class="modal-content" style="max-width: 420px; text-align: center;">
        <button class="modal-close" onclick="closeConfirmLogout()">✕</button>
        <h2 style="color: var(--text-primary); font-size: 24px; margin-bottom: 16px;"> Выйти из аккаунта?</h2>
        <p style="color: var(--text-secondary); margin-bottom: 24px;">Вы уверены, что хотите выйти?</p>
        <div style="display: flex; gap: 12px; justify-content: center;">
            <button onclick="closeConfirmLogout()" class="modal-btn-primary" style="background: var(--bg-primary); color: var(--text-primary); flex: 1;">Остаться</button>
            <button onclick="logoutUser()" class="modal-btn-primary" style="flex: 1;">Выйти</button>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/profile.js') }}"></script>
{% endblock %}