{% extends 'base.html.twig' %}

{% block title %}Обучение - Vocal Trainer{% endblock %}

{% block content %}
<div class="learning-page">
    <div class="learning-header">
        <h1 class="page-title">
            <img src="{{ asset('images/music-icon.png') }}" alt="Музыка" class="page-icon">
            Выбери тренировку
        </h1>
    </div>
    <div class="learning-cards-area">
        <div class="training-cards">
            <div class="card-wrapper">
                <a href="{{ path('training_hearing') }}" class="training-card training-card-hearing">
                    <div class="card-content">
                        <img src="{{ asset('images/ear-icon.png') }}" alt="Слух" class="card-icon-img">
                        <h2>
                            <span class="card-title">Тренировка</span>
                            <span class="card-title">слуха</span>
                        </h2>
                        <p>Учись определять ноты, интервалы и аккорды на слух</p>
                    </div>
                </a>
            </div>
            <div class="card-wrapper">
                <a href="{{ path('training_voice') }}" class="training-card training-card-voice">
                    <div class="card-content">
                        <img src="{{ asset('images/voice-icon.png') }}" alt="Голос" class="card-icon-img">
                        <h2>
                            <span class="card-title">Тренировка</span>
                            <span class="card-title">голоса</span>
                        </h2>
                        <p>Развивай вокальные навыки, работай над интонацией</p>
                    </div>
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}