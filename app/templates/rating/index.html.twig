{% extends 'base.html.twig' %}

{% block title %}{{ page_title }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/rating.css') }}">
{% endblock %}

{% block content %}
    <div class="learning-header">
        <h1 class="page-title">
            <img src="{{ asset('images/trophy-icon.png') }}" alt="Рейтинг" style="width: 3.5vh; height: 3.5vh; object-fit: contain; display: inline-block; vertical-align: middle; margin-right: 1vh;">
            Рейтинг
        </h1>
    </div>

    <div class="learning-content">
        <div class="rating-table-container">
            
            {% if usersData is empty %}
                <div class="rating-empty">
                    <h2>Таблица лидеров</h2>
                    <p>Пока нет участников. Будь первым!</p>
                </div>
            {% else %}
                <table class="rating-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Пользователь</th>
                            <th>
                                <img src="{{ asset('images/fire-icon.png') }}" alt="Серия" class="table-icon">
                                Серия
                            </th>
                            <th>
                                <img src="{{ asset('images/target-icon.png') }}" alt="Очки" class="table-icon">
                                Очки
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in usersData %}
                            {% set user = item.user %}
                            <tr>
                                <td class="col-place">{{ loop.index }}</td>
                                <td class="col-user">
                                    <div class="col-user-wrap">
                                        <img src="{{ asset('images/avatars/' ~ user.avatar) }}" 
                                            alt="Аватар" 
                                            class="user-avatar">
                                        <span class="user-name">{{ user.username }}</span>
                                        {% if app.user and app.user.id == user.id %}
                                            <span class="user-badge">Вы</span>
                                        {% endif %}
                                    </div>
                                </td>
                                <td class="col-streak">
                                    {% if item.streak > 0 %}
                                        {{ item.streak }}
                                    {% else %}
                                        —
                                    {% endif %}
                                </td>
                                <td class="col-score">{{ item.calculatedScore }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}

        </div>
    </div>
{% endblock %}