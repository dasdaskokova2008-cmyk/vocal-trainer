{% extends 'base.html.twig' %}

{% block title %}{{ page_title }}{% endblock %}

{% block content %}
    <div class="learning-header">
        <h1 class="page-title">
            <img src="{{ asset('images/trophy-icon.png') }}" alt="Рейтинг" style="width: 3.5vh; height: 3.5vh; object-fit: contain; display: inline-block; vertical-align: middle; margin-right: 1vh;">
            Рейтинг
        </h1>
    </div>

    <div class="learning-content">
        <div style="background: var(--bg-secondary); border-radius: 20px; box-shadow: var(--shadow); padding: 30px; overflow-x: auto;">
            
            {% if users is empty %}
                <div style="text-align: center; padding: 40px 20px;">
                    <h2 style="color: var(--text-primary); margin-bottom: 20px;">Таблица лидеров</h2>
                    <p style="color: var(--text-secondary); font-size: 1.2rem;">
                        Пока нет участников. Будь первым!
                    </p>
                </div>
            {% else %}
                <table style="width: 100%; border-collapse: collapse; font-size: 16px;">
                    <thead>
                        <tr style="border-bottom: 2px solid var(--border-color);">
                            <th style="padding: 15px 10px; text-align: center; color: var(--text-secondary); font-weight: 600; width: 80px;">#</th>
                            <th style="padding: 15px 10px; text-align: left; color: var(--text-secondary); font-weight: 600;">Пользователь</th>
                            <th style="padding: 15px 10px; text-align: center; color: var(--text-secondary); font-weight: 600; width: 120px;">
                                <img src="{{ asset('images/target-icon.png') }}" alt="Очки" style="width: 2vh; height: 2vh; object-fit: contain; display: inline-block; vertical-align: middle; margin-right: 0.3vh;">
                                Очки
                            </th>
                            <th style="padding: 15px 10px; text-align: center; color: var(--text-secondary); font-weight: 600; width: 120px;">
                                <img src="{{ asset('images/trophy-icon.png') }}" alt="Место" style="width: 2vh; height: 2vh; object-fit: contain; display: inline-block; vertical-align: middle; margin-right: 0.3vh;">
                                Место
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for user in users %}
                            <tr style="border-bottom: 1px solid var(--border-color); transition: background 0.2s ease;">
                                <td style="padding: 15px 10px; text-align: center; font-weight: 700; font-size: 18px;">
                                    {% if loop.index == 1 %}
                                        🥇
                                    {% elseif loop.index == 2 %}
                                        🥈
                                    {% elseif loop.index == 3 %}
                                        🥉
                                    {% else %}
                                        {{ loop.index }}
                                    {% endif %}
                                </td>
                                <td style="padding: 15px 10px; text-align: left; font-weight: 500; display: flex; align-items: center; gap: 12px;">
                                    <img src="{{ asset('images/avatars/' ~ user.avatar) }}" 
                                        alt="Аватар" 
                                        style="width: 36px; height: 36px; border-radius: 50%; border: 2px solid var(--border-color); object-fit: cover;">
                                    <span style="color: var(--text-primary);">{{ user.username }}</span>
                                    {% if app.user and app.user.id == user.id %}
                                        <span style="background: var(--accent-primary); color: white; padding: 2px 12px; border-radius: 12px; font-size: 12px; font-weight: 600;">Вы</span>
                                    {% endif %}
                                </td>
                                <td style="padding: 15px 10px; text-align: center; font-weight: 700; color: var(--accent-primary); font-size: 18px;">
                                    {{ user.score }}
                                </td>
                                <td style="padding: 15px 10px; text-align: center; font-weight: 600; color: var(--text-secondary);">
                                    {{ loop.index }}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}

            {% if app.user %}
                <div style="margin-top: 30px; padding: 20px; background: linear-gradient(135deg, rgba(74, 158, 255, 0.08), rgba(108, 92, 231, 0.08)); border-radius: 16px; border: 2px solid var(--accent-primary); display: flex; justify-content: space-around; flex-wrap: wrap; gap: 20px;">
                    <div style="text-align: center;">
                        <div style="color: var(--text-secondary); font-size: 14px;">Ваше место</div>
                        <div style="font-size: 32px; font-weight: 800; color: var(--accent-primary);">
                            {% set userPlace = 0 %}
                            {% for user in users %}
                                {% if app.user.id == user.id %}
                                    {% set userPlace = loop.index %}
                                {% endif %}
                            {% endfor %}
                            {% if userPlace > 0 %}
                                {{ userPlace }}
                            {% else %}
                                —
                            {% endif %}
                        </div>
                    </div>
                    <div style="text-align: center;">
                        <div style="color: var(--text-secondary); font-size: 14px;">Ваши очки</div>
                        <div style="font-size: 32px; font-weight: 800; color: var(--accent-primary);">
                            {{ app.user.score }}
                        </div>
                    </div>
                    <div style="text-align: center;">
                        <div style="color: var(--text-secondary); font-size: 14px;">Всего участников</div>
                        <div style="font-size: 32px; font-weight: 800; color: var(--accent-primary);">
                            {{ users|length }}
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .learning-content {
            max-width: 900px;
            margin: 0 auto;
            padding: 20px 0;
            width: 100%;
        }
        tbody tr:hover {
            background: var(--bg-primary);
        }
        @media (max-width: 600px) {
            table {
                font-size: 14px;
            }
            td, th {
                padding: 10px 6px !important;
            }
        }
    </style>
{% endblock %}