{% extends 'base.html.twig' %}

{% block title %}{{ page_title }}{% endblock %}

{% block content %}
<div class="login-page">
    <div class="login-container">
        <h1 class="login-title">Добро пожаловать!</h1>
        <p class="login-subtitle">Войдите в свой аккаунт</p>

        {% if error %}
            <div class="login-error">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <form method="post" action="{{ path('login') }}" class="login-form">
            <div class="form-group">
                <label for="username">Логин</label>
                <input type="text" id="username" name="username" value="{{ last_username }}" required>
            </div>

            <div class="form-group">
                <label for="password">Пароль</label>
                <input type="password" id="password" name="password" required>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit" class="login-btn">
                Войти
            </button>
        </form>

        <div class="login-footer">
            Нет аккаунта? <a href="{{ path('register') }}">Зарегистрироваться</a>
        </div>
    </div>
</div>
{% endblock %}